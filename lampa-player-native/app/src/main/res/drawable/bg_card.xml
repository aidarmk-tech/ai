<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_focused="true">
        <shape>
            <solid android:color="@color/focus_surface" />
            <stroke android:width="2dp" android:color="@color/focus_outline" />
            <corners android:radius="14dp" />
        </shape>
    </item>
    <item android:state_activated="true">
        <shape>
            <solid android:color="#1F3048" />
            <stroke android:width="1dp" android:color="#355983" />
            <corners android:radius="14dp" />
        </shape>
    </item>
    <item>
        <shape>
            <solid android:color="@color/bg_surface" />
            <corners android:radius="14dp" />
        </shape>
    </item>
</selector>
