def sha256(path: Path) -> str:
    digest = hashlib.sha256()
    with path.open("rb") as handle:
        for chunk in iter(lambda: handle.read(1024 * 1024), b""):
            digest.update(chunk)
    return digest.hexdigest()


def run(args: list[str], *, cwd: Path | None = None, env: dict[str, str] | None = None,
        check: bool = True, capture: bool = False) -> subprocess.CompletedProcess[str]:
    print("+", " ".join(str(value) for value in args), flush=True)
    return subprocess.run(
        [str(value) for value in args], cwd=cwd, env=env, check=check,
        text=True, stdout=subprocess.PIPE if capture else None,
        stderr=subprocess.STDOUT if capture else None,
    )


def systemctl(*args: str, check: bool = True) -> subprocess.CompletedProcess[str]:
    return run(["systemctl", *args], check=check, capture=not check)


def is_active(service: str) -> bool:
    return subprocess.run(["systemctl", "is-active", "--quiet", service]).returncode == 0


def server_root() -> Path:
    return Path(os.environ.get("PUMPRADAR_SERVER_ROOT", "/opt/pumpradar/server"))


def db_path() -> Path:
    return Path(os.environ.get("PUMPRADAR_DB", "/var/lib/pumpradar/pumpradar.sqlite3"))


def python_path() -> Path:
    return Path(os.environ.get("PUMPRADAR_PYTHON", "/opt/pumpradar/venv/bin/python"))


def resolve_destination(entry: dict[str, Any]) -> Path:
    original = str(entry["destination"])
    prefix = "/opt/pumpradar/server/"
    if original.startswith(prefix):
        return server_root() / original.removeprefix(prefix)
    override = os.environ.get("PUMPRADAR_DEST_PREFIX")
    return Path(override + original) if override else Path(original)


def atomic_copy(src: Path, dst: Path, mode: int) -> None:
    dst.parent.mkdir(parents=True, exist_ok=True)
    fd, temp_name = tempfile.mkstemp(prefix=dst.name + ".", dir=dst.parent)
    temp = Path(temp_name)
    try:
        with os.fdopen(fd, "wb") as out, src.open("rb") as inp:
            shutil.copyfileobj(inp, out)
            out.flush()
            os.fsync(out.fileno())
        os.chmod(temp, mode)
        os.replace(temp, dst)
    finally:
        temp.unlink(missing_ok=True)


def safe_extract(payload: Path, target: Path) -> None:
    with tarfile.open(payload, "r:gz") as archive:
        root = target.resolve()
        for member in archive.getmembers():
            destination = (target / member.name).resolve()
            if root not in destination.parents and destination != root:
                raise RuntimeError(f"unsafe payload member: {member.name}")
            if member.issym() or member.islnk() or not (member.isfile() or member.isdir()):
                raise RuntimeError(f"unexpected payload member: {member.name}")
        archive.extractall(target)


def materialize_payload(root: Path) -> tuple[Path, dict[str, Any]]:
    payload = root / "pumpradar-v4531-payload.tar.gz"
    payload.write_bytes(base64.b64decode(PAYLOAD_B64.encode("ascii"), validate=True))
    actual = sha256(payload)
    if actual != EXPECTED_PAYLOAD_SHA256:
        raise RuntimeError(f"embedded payload SHA-256 mismatch: {actual}")
    extracted = root / "payload"
    extracted.mkdir()
    safe_extract(payload, extracted)
    manifest = json.loads((extracted / "manifest.json").read_text(encoding="utf-8"))
    if manifest.get("release") != RELEASE or manifest.get("algorithm_version") != ALGORITHM_VERSION:
        raise RuntimeError("unexpected release manifest")
    expected = {"manifest.json"}
    for entry in manifest["entries"]:
        relative = str(entry["payload"])
        expected.add(relative)
        member = extracted / relative
        if not member.is_file() or sha256(member) != str(entry["final_sha256"]):
            raise RuntimeError(f"payload member mismatch: {relative}")
    actual_files = {str(path.relative_to(extracted)) for path in extracted.rglob("*") if path.is_file()}
    if actual_files != expected:
        raise RuntimeError(f"unexpected payload members: {sorted(actual_files - expected)}")
    return extracted, manifest


def verify_live_inputs(manifest: dict[str, Any]) -> None:
    for entry in manifest["entries"]:
        destination = resolve_destination(entry)
        final_hash = str(entry["final_sha256"])
        base_hash = entry.get("base_sha256")
        if destination.is_file():
            actual = sha256(destination)
            permitted = {final_hash}
            if base_hash:
                permitted.add(str(base_hash))
            if actual not in permitted:
                raise RuntimeError(f"unexpected live file SHA-256: {destination}: {actual}")
        elif base_hash:
            raise RuntimeError(f"required live file missing: {destination}")


def safety_scan(candidate: Path) -> None:
    source = "\n".join(
        path.read_text(encoding="utf-8")
        for path in (candidate / "pumpradar_server").glob("*.py")
    )
    forbidden = ("/fapi/v1/order", "/api/v3/order", "create_order", "newOrder", "API_SECRET")
    found = [token for token in forbidden if token in source]
    if found:
        raise RuntimeError(f"real-order marker(s) found: {found}")


def baseline(db: Path) -> dict[str, tuple[int, float]]:
    connection = sqlite3.connect(db)
    try:
        rows = connection.execute(
            """SELECT channel,COUNT(*),COALESCE(SUM(net_pnl_usdt),0)
               FROM regime_slots WHERE status='CLOSED' GROUP BY channel"""
        ).fetchall()
        return {str(row[0]): (int(row[1]), float(row[2])) for row in rows}
    finally:
        connection.close()


