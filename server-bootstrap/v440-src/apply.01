    "pumpradar-server/pumpradar_server/main.py",
    '    async def position_loop(self) -> None:\n',
    '    async def futures_engine_loop(self) -> None:\n        """Evaluate the same MC5/MC7 gates on an independent USD-M feed."""\n        while not self.stop_event.is_set():\n            now = int(time.time() * 1000)\n            try:\n                ranked = self.futures_state.rank_universe(\n                    self.settings.futures_minimum_24h_quote_volume,\n                    now,\n                )\n                candidates = [\n                    c for c in ranked if self.futures_state.is_pre_candidate(c)\n                ][: self.settings.futures_max_candidates]\n                candidate_map = {c.symbol: c for c in ranked}\n                decision_candidates = list(\n                    candidates[: self.settings.futures_deep_candidates]\n                )\n                decision_seen = {c.symbol for c in decision_candidates}\n                forced = [\n                    c\n                    for c in ranked\n                    if (\n                        c.return_5m is not None\n                        and c.return_5m >= self.settings.momentum_mc5_return_5m\n                    )\n                    or (\n                        c.return_10m is not None\n                        and c.return_10m >= self.settings.momentum_mc7_return_10m\n                    )\n                ]\n                for candidate in forced:\n                    if candidate.symbol not in decision_seen:\n                        decision_candidates.append(candidate)\n                        decision_seen.add(candidate.symbol)\n                    if len(decision_candidates) >= self.settings.futures_max_candidates:\n                        break\n                next_decisions = {c.symbol for c in decision_candidates}\n                active = self.futures_store.open_slot()\n                active_symbol = str(active["symbol"]) if active else None\n                pending = self.futures_store.pending_symbols()\n\n                refresh_due = (\n                    now - self.futures_last_candidate_set_ms\n                    >= self.settings.warm_refresh_seconds * 1000\n                )\n                if refresh_due:\n                    warm = {\n                        c.symbol\n                        for c in ranked[: self.settings.futures_warm_pool_size]\n                    }\n                    warm.update(next_decisions)\n                    warm.update(pending)\n                    if active_symbol:\n                        warm.add(active_symbol)\n                    depth = {\n                        c.symbol\n                        for c in ranked[: self.settings.futures_depth_candidates]\n                    }\n                    depth.update(next_decisions)\n                    depth.update(pending)\n                    if active_symbol:\n                        depth.add(active_symbol)\n                    self.futures_warm_symbols = warm\n                    self.futures_depth_symbols = depth\n                    self.futures_state.retain_detailed_symbols(warm)\n                    self.futures_state.retain_depth_symbols(depth)\n                    self.futures_feed.set_candidate_symbols(\n                        sorted(warm), sorted(depth)\n                   