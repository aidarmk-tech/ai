[Unit]
Description=PumpRadar measurement server
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=pumpradar
Group=pumpradar
WorkingDirectory=/opt/pumpradar/server
EnvironmentFile=/etc/pumpradar/server.env
ExecStart=/opt/pumpradar/venv/bin/python -m pumpradar_server.main
Restart=always
RestartSec=5
TimeoutStopSec=45
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/pumpradar
MemoryMax=650M
MemoryHigh=520M
MemorySwapMax=256M
OOMPolicy=stop
TasksMax=128
LimitNOFILE=65536

[Install]
WantedBy=multi-user.target
